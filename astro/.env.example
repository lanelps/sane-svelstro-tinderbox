# Sanity — required
PUBLIC_SANITY_PROJECT_ID="your-project-id"
PUBLIC_SANITY_DATASET="production"

# Sanity Token — required for preview builds (the `drafts` perspective needs auth).
# Also required for private Sanity projects.
# SANITY_TOKEN="your-sanity-read-token"

# Build mode — "production" (default) or "preview".
#   production → SSG, published content
#   preview    → SSR, draft content, Sanity Visual Editing overlay
# Set to "preview" only on the preview Worker. `pnpm build:preview` sets it for you.
PUBLIC_BUILD_MODE="production"

# Canonical site URL — feeds `site` in astro.config.mjs (sitemap + canonical tags).
PUBLIC_SITE_URL="https://www.example.com"

# #region shopify
# Shopify Storefront API
PUBLIC_SHOPIFY_STORE="your-store.myshopify.com"
PUBLIC_SHOPIFY_STOREFRONT_TOKEN="your-storefront-token"
# #endregion shopify
