---
// #shopify-file
import Layout from "@layouts/Layout.astro";
import VariantSelector from "@components/VariantSelector.svelte";
import Sections from "@components/Sections.astro";

import { productsQuery, productQuery } from "@utils/queires";
import { stripHtml } from "@utils/helpers";

import { fetchQuery, fetchPage } from "@utils/load-query";
import type { ProductsData, ProductData } from "@/types";
import type { QueryParams } from "sanity";

/**
 * @name getStaticPaths
 * @function
 * @description Fetches all products from Sanity and generates static path params for each product slug.
 * Used by production (SSG) builds; ignored in preview (SSR) builds, where routes are matched on demand.
 * @returns {Promise<{ params: { slug: string } }[]>} An array of static path parameter objects.
 */
export const getStaticPaths = async () => {
  const { data: products } = await fetchQuery<ProductsData[]>({
    query: productsQuery,
  });

  return products.map((product) => {
    return {
      params: {
        slug: product.slug.current,
      },
    };
  });
};

const params = Astro.params as QueryParams;

const { data: product } = await fetchPage<ProductData>({
  query: productQuery,
  params,
});

if (!product) return Astro.redirect("/404");

const pageSeo = {
  title: product?.details?.seo?.title || product?.details?.store?.title || "",
  description:
    product?.details?.seo?.description ||
    stripHtml(product?.details?.store?.descriptionHtml) ||
    "",
  keywords: product?.details?.seo?.keywords || [],
  image: product?.details?.store?.previewImageUrl,
};
---

<Layout seo={pageSeo}>
  <h1 class="text-h1">{product.details.store.title}</h1>

  <VariantSelector
    title={product.details.store.title}
    variants={product.variants}
    client:load
  />

  <Sections sections={product.details.sections} />
</Layout>
