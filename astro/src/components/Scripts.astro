---
import type { Script } from "@/types";

interface Props {
  scripts: Script[];
}

const { scripts } = Astro.props;
---

{
  scripts?.map((script) => {
    if (!script.value) return null;

    if (script._type === "scriptInline") {
      return <script is:inline type="text/partytown" set:html={script.value} />;
    }

    return <script is:inline type="text/partytown" src={script.value} async />;
  })
}
