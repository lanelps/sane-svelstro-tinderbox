---
import { getLinkAttributes } from "@utils/links";

import type { InlineLinkMarkDef } from "@/types";

interface Props {
  node: {
    markDef: InlineLinkMarkDef;
  };
}

const { node } = Astro.props as Props;

const attributes = getLinkAttributes(node.markDef);
---

{
  attributes ? (
    <a {...attributes} class="text-b1 underline">
      <slot />
    </a>
  ) : (
    <slot />
  )
}
