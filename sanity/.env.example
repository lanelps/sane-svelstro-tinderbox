SANITY_STUDIO_PROJECT_ID="your-project-id"
SANITY_STUDIO_DATASET="production"

# Visual editing / Presentation tool.
# Both must be set for the Presentation tab to appear in the Studio.
#
# PREVIEW_URL must point at a frontend built with PUBLIC_BUILD_MODE=preview,
# and must be a bare origin — http(s), no path, no trailing slash:
#   local dev  → http://localhost:4321
#   deployed   → https://<your-preview-worker>.workers.dev
SANITY_STUDIO_VISUAL_EDITING_ENABLED="true"
SANITY_STUDIO_PREVIEW_URL="http://localhost:4321"

# #region shopify
# Shopify store ID — the ID in your Shopify admin URL
# (e.g. 'my-store' in https://admin.shopify.com/store/my-store).
# Enables the Shopify admin shortcut in the Studio navbar.
SANITY_STUDIO_SHOPIFY_STORE_ID=""
# #endregion shopify
